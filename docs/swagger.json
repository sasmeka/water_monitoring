    "basePath": "/water-monitoring/auth",
    "paths": {
        "/water-monitoring": {
            "get": {
                "description": "Mendapatkan daftar data hasil monitoring air dengan pagination dan opsional filter id_device",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Water Monitoring"
                ],
                "summary": "Ambil Riwayat Data Water Monitoring",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter berdasarkan ID Device (misal: DEV-001)",
                        "name": "id_device",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Halaman (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Jumlah data per halaman (default 10)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.ResWaterMonitoringList_HTTP200"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.HTTP500"
                        }
                    }
                }
            },
            "post": {
                "description": "Menyimpan data hasil monitoring air (Suhu, pH, TDS, Turbidity, Status, dll)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Water Monitoring"
                ],
                "summary": "Input Data Water Monitoring",
                "parameters": [
                    {
                        "description": "Data Water Monitoring",
                        "name": "Request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.BodyWaterMonitoring"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.ResWaterMonitoring_HTTP200"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/models.HTTP400"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/models.HTTP500"
                        }
                    }
                }
            }
        },
        "/water-monitoring/batch": {
            "post": {
                "description": "Menyimpan array data hasil monitoring air sekaligus",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Water Monitoring"
                ],
                "summary": "Input Banyak Data Water Monitoring (Batch/Bulk)",
                "parameters": [
                    {
                        "description": "Batch Data Water Monitoring",
                        "name": "Request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.BodyWaterMonitoringBatch"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
